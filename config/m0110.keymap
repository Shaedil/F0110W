/*
 * Apple M0110 keymap for ZMK
 *
 * 57 keys, matching the transform in
 * config/boards/shields/m0110/m0110-layouts.dtsi.  The M0110 has no keypad, no
 * arrow keys and no function row, so those live on the Fn layer, reached by
 * holding the backslash key.
 *
 * +---+---+---+---+---+---+---+---+---+---+---+---+---+-----+
 * | ` | 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | 9 | 0 | - | = | bsp |
 * +---+---+---+---+---+---+---+---+---+---+---+---+---+-----+
 * |  tab  | q | w | e | r | t | y | u | i | o | p | [ | ]   |
 * +-------+---+---+---+---+---+---+---+---+---+---+---+-----+
 * |  caps  | a | s | d | f | g | h | j | k | l | ; | ' |ret |
 * +--------+---+---+---+---+---+---+---+---+---+---+---+----+
 * |  shift   | z | x | c | v | b | n | m | , | . | / | shift|
 * +----------+---+---+---+---+---+---+---+---+---+---+------+
 * | opt | cmd |          space          |  \  |    enter    |
 * +-----+-----+-------------------------+-----+-------------+
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define FN      1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* Row 0: number row */
                &kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS  &kp EQUAL  &kp BSPC

                /* Row 1: QWERTY */
                &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp LBKT   &kp RBKT

                /* Row 2: home row */
                &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT    &kp RET

                /* Row 3: shift row.  The right shift never fires; both shifts
                 * report the same scancode, so it arrives as the left one. */
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT

                /* Row 4: bottom row */
                &kp LCTRL  &kp LGUI   &kp SPACE                                                                    &lt FN BSLH           &kp KP_ENTER
            >;
        };

        fn_layer {
            bindings = <
                /* Row 0: function keys */
                &kp ESC    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12    &kp DEL

                /* Row 1: outputs and Bluetooth profiles */
                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_USB &out OUT_BLE &kp PSCRN &kp SLCK &kp PAUSE_BREAK &kp UP &kp INS

                /* Row 2: volume and navigation */
                &trans     &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans  &trans     &trans     &trans     &kp HOME   &kp PG_UP  &kp LEFT   &kp RIGHT  &trans

                /* Row 3: firmware controls and the rest of navigation */
                &trans     &studio_unlock &bootloader &trans  &trans     &bt BT_CLR &trans     &trans     &kp END    &kp PG_DN  &kp DOWN   &trans

                /* Row 4 */
                &trans     &trans     &trans                                                                       &trans                &trans
            >;
        };
    };
};
