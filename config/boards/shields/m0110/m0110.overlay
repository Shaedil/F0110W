/*
 * M0110 keyboard converter shield.
 *
 * The keyboard speaks a two-wire synchronous serial protocol, so the shield
 * needs three signals and no matrix at all:
 *
 *   data   -> M0110 DATA   (open collector, pulled up on this side)
 *   clock  -> M0110 CLOCK  (likewise; the keyboard always drives it)
 *   en     -> bq25185 boost EN, which powers the M0110's +5 V rail
 *
 * Ground is shared.  The pins themselves are per-board and live in
 * `boards/<board>.overlay` next to this file; the defaults below are the
 * nice!nano v2 wiring.
 */

#include "m0110-layouts.dtsi"

/ {
    chosen {
        zmk,matrix-input = &m0110;
        zmk,physical-layout = &m0110_layout;
    };

    m0110: m0110 {
        compatible = "zmk,input-m0110";
        status = "okay";

        // nice!nano v2, Pro Micro pinout: D2 = P0.17, D3 = P0.20, D1 = P0.06
        data-gpios = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        clock-gpios = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

        /* bq25185 boost EN, held high to power the M0110's +5 V rail on
         * battery. Without it the matrix is unpowered off USB, so BLE
         * connects but no keys register. The driver only power-saves after
         * idle-timeout-ms (default 5 minutes). */
        en-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;

        /* Virtual matrix the driver spreads scancodes over: 14 rows x 8 columns.
         * A plain M0110 only ever uses the first eight rows; the keypad and
         * arrow blocks above them belong to the M0110A and M0120. */
        rows = <14>;
        columns = <8>;
    };
};

// USB CDC ACM for logging and Studio RPC
&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
    studio_uart: studio_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zmk,studio-rpc-uart = &studio_uart;
    };
};
